    "default": {
      "$value": "2px"
    },
    "appTile": {
      "$value": "22%"
    }
  },
  "rules": [
    "One gold mark per frame: the action, the accent phrase or the level line.",
    "Blue is up, red is down; both are for price and R only, never buttons or headlines.",
    "No green anywhere.",
    "Radius 0 to 2px; no pills on print."
