{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Blueprint Trades",
  "source": "Kit design system v1.0: /mnt/project-files/youtube-brand/design-system (Field Notes). Store adds dark mode and UI roles.",
  "color": {
    "paper": {
      "light": "#ECE5D2",
      "dark": "#1E1D1A",
      "role": "page ground (--db-mid)"
    },
    "paper-deep": {
      "light": "#E4DCC6",
      "dark": "#161513",
      "role": "alternate section (--db-deep)"
    },
    "card": {
      "light": "#F5F0E3",
      "dark": "#282622",
      "role": "raised surface (--db-raised)"
    },
    "rule": {
      "light": "#C9BEA2",
      "dark": "#423E37",
      "role": "borders, dividers (--db-line)"
    },
    "graph": {
      "light": "#DDD3BA",
      "dark": "#2C2A26",
      "role": "graph-paper grid (--db-grid)"
    },
    "graphite": {
      "light": "#1E1D1A",
      "dark": "#ECE5D2",
      "role": "text (--db-ink)"
    },
    "steel": {
      "light": "#625C50",
      "dark": "#A8A08E",
      "role": "secondary text (--db-muted)"
    },
    "red-pencil": {
      "light": "#B8361F",
      "dark": "#EC6850",
      "role": "primary action + accent (--db-sun / --db-ember); kit value #D2402B for print"
    },
    "gain": {
      "light": "#1E1D1A",
      "dark": "#ECE5D2",
      "role": "positive R: graphite, per the kit's no-green rule"
    },
    "loss": {
      "light": "#B8361F",
      "dark": "#EC6850",
      "role": "negative R: red pencil"
    },
    "print-cover": {
      "navy": "#161A3A",
      "gold-wire": "#D4A640",
      "role": "Bull & Bear printed edition only"
    }
  },
  "font": {
    "display": {
      "family": "Anton",
      "use": "headlines, uppercase, line-height 0.95"
    },
    "body": {
      "family": "Instrument Sans",
      "use": "running text 16-18px, 1.6 line-height"
    },
    "label": {
      "family": "JetBrains Mono",
      "use": "labels and numbers, 12px uppercase, 0.14em tracking, tabular-nums"
    },
    "hand": {
      "family": "Nothing You Could Do",
      "use": "sample handwriting and red-pencil notes only; never for UI text"
    }
  },
  "type-scale-px": {
    "label": 12,
    "small": 14,
    "body": 16,
    "lead": 18,
    "h3": 20,
    "h2-mobile": 48,
    "h2": 60,
    "h1-mobile": 64,
    "h1": 104
  },
  "space-px": [
    4,
    8,
    12,
    16,
    24,
    32,
    40,
    64,
    80
  ],
  "radius-px": {
    "sm": 2,
    "md": 6,
    "note": "drafting-sheet corners; no pills"
  },
  "border-px": {
    "hairline": 1,
    "frame": 2,
    "rule": 4
  },
  "shadow": {
    "light": "0 10px 30px rgba(60,50,20,.16)",
    "dark": "0 8px 24px rgba(0,0,0,.5)"
  },
  "motion": {
    "tape": "38s linear loop",
    "note-float": "6s ease-in-out",
    "reduced-motion": "all off"
  },
  "touch-target-px": 44
}